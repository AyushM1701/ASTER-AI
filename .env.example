# All defaults run without any model download.
ANSWER_MODE=extractive
RETRIEVAL_BACKEND=lexical
OLLAMA_BASE_URL=http://127.0.0.1:11434
TEXT_MODEL=llama3:8b
# The single chat uses one pretrained text/vision model when explicitly set up.
# Set both tags to qwen3-vl:2b-instruct after running setup-chat.ps1.
VISION_MODEL=qwen3-vl:2b-instruct
ENABLE_GENERAL_CHAT=false
# Automatically checks PATH and the usual Windows Program Files installation.
TESSERACT_CMD=
# Experimental local English handwriting; requires VISION_MODEL in Ollama.
ENABLE_HANDWRITING_OCR=false
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_SESSION_BYTES=31457280
SESSION_TTL_SECONDS=1800
SESSION_HARD_TTL_SECONDS=7200
MAX_ACTIVE_SESSIONS=20
MAX_DOCUMENTS_PER_SESSION=5
MAX_QUEUE_SIZE=4
INFERENCE_TIMEOUT_SECONDS=180
OCR_TIMEOUT_SECONDS=30
ENABLE_XRAY=false
# Paths resolve against the project root, not the shell's current directory.
CORPUS_PATH=data/references/normalized/seed.jsonl
SOURCE_REGISTER=configs/sources.yaml
CHROMA_PATH=data/indexes/reference_v1
EMBEDDING_PATH=data/models/minilm
XRAY_MANIFEST=configs/xray_assets.yaml
XRAY_WEIGHTS_MANIFEST=configs/xray_weights.json
# Separate curriculum teaching collection. Enable only after validating a release
# and building its matching index; medicine-product settings stay independent.
ENABLE_TEACHING=false
ENABLE_MDS_PIPELINE=true
# off or shadow. Shadow drafts are evaluated locally and never displayed.
MDS_SYNTHESIS_MODE=off
TEACHING_BACKEND=lexical
TEACHING_RELEASE_PATH=data/references/mbbs/releases/aster-mbbs-v1-r3-final-2026-10-08
TEACHING_INDEX_PATH=data/indexes/mbbs-v1-r3-final
TEACHING_EXPLANATIONS_PATH=data/references/mbbs/explanations/v1-r3-final.json
TEACHING_EXPLANATIONS_SHA256=1eceabe9f3dd7d03c9d14464f08762c9fa10042e26c04e6f160ad3955df495e8
# Bounded symptom-information pilot, separate from postgraduate teaching.
# Missing, changed or stale patient evidence fails closed; sources expire in 7 days.
ENABLE_PATIENT_INFORMATION=true
ENABLE_RESEARCH_SEARCH=true
WORKSPACE_PATH=data/workspaces/education.sqlite3
PATIENT_RELEASE_PATH=data/references/patient/releases/aster-patient-v1-2026-10-10
# Topic/facet extraction; disabling it retains the common terminal guard.
ENABLE_MDS_PIPELINE=true
# off or shadow: shadow drafts are measured locally and never displayed.
MDS_SYNTHESIS_MODE=off
